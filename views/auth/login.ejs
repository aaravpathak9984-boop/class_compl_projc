<!-- ==========================================================================
     Clean Minimalist Login View (views/auth/login.ejs)
     ========================================================================== -->
<div class="auth-wrapper">
  <div class="auth-card">
    <div class="auth-header">
      <h1 class="auth-title">Welcome back</h1>
      <p class="auth-subtitle">Sign in to your Cineplex account</p>
    </div>

    <form action="/auth/login" method="POST" class="auth-form">
      <!-- Email or Username -->
      <div class="field-group">
        <label for="email" class="field-label">Email or Username <span class="text-danger">*</span></label>
        <input type="text" id="email" name="email" required class="clean-input" placeholder="e.g. user@example.com" autocomplete="username">
      </div>

      <!-- Password -->
      <div class="field-group">
        <label for="password" class="field-label">Password <span class="text-danger">*</span></label>
        <input type="password" id="password" name="password" required class="clean-input" placeholder="Enter your password" autocomplete="current-password">
      </div>

      <!-- Submit Button -->
      <button type="submit" class="btn-clean-primary mt-2">
        Sign in
      </button>
    </form>

    <div class="auth-footer">
      <span class="text-muted">Don't have an account?</span>
      <a href="/auth/register" class="auth-link">Create account</a>
    </div>
  </div>
</div>
