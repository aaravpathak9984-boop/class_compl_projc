<!-- ==========================================================================
     Simple, Clean Register View (views/auth/register.ejs)
     ========================================================================== -->
<div class="auth-wrapper">
  <div class="auth-card">
    <div class="auth-header">
      <h1 class="auth-title">Create Account</h1>
      <p class="auth-subtitle">Sign up to start booking movie tickets</p>
    </div>

    <form action="/auth/register" method="POST" id="registerForm" class="auth-form">
      <!-- Full Name -->
      <div class="field-group">
        <label for="name" class="field-label">Full Name</label>
        <input type="text" id="name" name="name" required class="clean-input" placeholder="e.g. Aarav Pathak" autocomplete="name">
      </div>

      <!-- Email -->
      <div class="field-group">
        <label for="email" class="field-label">Email Address</label>
        <input type="email" id="email" name="email" required class="clean-input" placeholder="you@example.com" autocomplete="email">
      </div>

      <!-- Password -->
      <div class="field-group">
        <label for="password" class="field-label">Password</label>
        <div class="input-with-action">
          <input type="password" id="password" name="password" required class="clean-input" placeholder="At least 6 characters" autocomplete="new-password">
          <button type="button" class="input-action-btn" id="togglePasswordBtn" title="Show/hide password">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
              <circle cx="12" cy="12" r="3"></circle>
            </svg>
          </button>
        </div>
      </div>

      <!-- Confirm Password -->
      <div class="field-group">
        <label for="confirmPassword" class="field-label">Confirm Password</label>
        <input type="password" id="confirmPassword" name="confirmPassword" required class="clean-input" placeholder="Re-type your password" autocomplete="new-password">
        <span id="matchStatus" class="field-hint"></span>
      </div>

      <!-- Submit Button -->
      <button type="submit" class="btn-clean-primary" id="submitBtn">
        Create Account
      </button>
    </form>

    <div class="auth-footer">
      <span class="text-muted">Already have an account?</span>
      <a href="/auth/login" class="auth-link">Log in</a>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const passwordInput = document.getElementById('password');
    const confirmInput = document.getElementById('confirmPassword');
    const toggleBtn = document.getElementById('togglePasswordBtn');
    const matchStatus = document.getElementById('matchStatus');

    // Toggle password visibility
    if (toggleBtn) {
      toggleBtn.addEventListener('click', () => {
        const type = passwordInput.getAttribute('type') === 'password' ? 'text' : 'password';
        passwordInput.setAttribute('type', type);
        confirmInput.setAttribute('type', type);
      });
    }

    // Check passwords match
    function checkMatch() {
      if (!confirmInput.value) {
        matchStatus.innerText = '';
        return;
      }
      if (passwordInput.value === confirmInput.value) {
        matchStatus.innerText = '✓ Passwords match';
        matchStatus.style.color = '#30d158';
      } else {
        matchStatus.innerText = '✕ Passwords do not match';
        matchStatus.style.color = '#ff453a';
      }
    }

    if (confirmInput) {
      confirmInput.addEventListener('input', checkMatch);
    }
    if (passwordInput) {
      passwordInput.addEventListener('input', checkMatch);
    }
  });
</script>
