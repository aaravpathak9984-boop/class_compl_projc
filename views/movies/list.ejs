<div class="search-section-dock">
  <form action="/movies" method="GET" class="search-form-dock glass-panel" id="movieSearchForm">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="search-icon"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
    <input type="text" name="search" id="movieSearchInput" placeholder="Search movies..." value="<%= searchQuery %>" class="form-control-dock" autocomplete="off">
    <select name="genre" id="movieGenreSelect" class="form-control-dock genre-select">
      <option value="">All Genres</option>
      <% const genres = ['Action', 'Comedy', 'Drama', 'Sci-Fi', 'Horror', 'Romance', 'Thriller', 'Animation', 'Documentary']; %>
      <% genres.forEach(g => { %>
        <option value="<%= g %>" <%= selectedGenre === g ? 'selected' : '' %>><%= g %></option>
      <% }) %>
    </select>
  </form>
  
  <% if (currentUser && currentUser.role === 'admin') { %>
    <a href="/movies/new" class="btn btn-primary btn-sm ml-3">Add Movie</a>
  <% } %>
</div>

<div id="moviesMainDisplay">

<% if (popular && popular.length > 0) { %>
  <div class="coverflow-section">
    <h2 class="section-title text-center mb-4">Popular Right Now</h2>
    <div class="coverflow-container" id="popularCoverflow">
      <% popular.forEach((movie, index) => { %>
        <div class="coverflow-card" data-index="<%= index %>" data-bg="<%= movie.posterUrl || '/images/default-poster.jpg' %>">
          <a href="/movies/<%= movie._id %>" class="coverflow-link">
            <img src="<%= movie.posterUrl || '/images/default-poster.jpg' %>" alt="<%= movie.title %>" class="coverflow-poster">
            <div class="coverflow-info glass-panel-high">
              <h3 class="movie-title"><%= movie.title %></h3>
              <p class="movie-genres text-muted"><%= movie.genre.join(', ') %></p>
            </div>
          </a>
        </div>
      <% }) %>
    </div>
  </div>
<% } %>

<div class="movie-sections">
  <% if (currentUser && recommended && recommended.length > 0) { %>
    <div class="carousel-section">
      <h2 class="section-title">Recommended for You</h2>
      <div class="movie-carousel">
        <% recommended.forEach(movie => { %>
          <div class="movie-card-square">
            <a href="/movies/<%= movie._id %>">
              <img src="<%= movie.posterUrl || '/images/default-poster.jpg' %>" alt="<%= movie.title %>" class="movie-poster">
              <div class="card-glass-overlay">
                <h3 class="movie-title"><%= movie.title %></h3>
              </div>
            </a>
          </div>
        <% }) %>
      </div>
    </div>
  <% } %>

  <div class="carousel-section mb-5 pb-5">
    <h2 class="section-title">All Movies</h2>
    <% if (movies.length > 0) { %>
      <div class="movie-carousel">
        <% movies.forEach(movie => { %>
          <div class="movie-card-square">
            <a href="/movies/<%= movie._id %>">
              <img src="<%= movie.posterUrl || '/images/default-poster.jpg' %>" alt="<%= movie.title %>" class="movie-poster">
              <div class="card-glass-overlay">
                <h3 class="movie-title"><%= movie.title %></h3>
              </div>
            </a>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <p class="text-muted p-4 glass-panel-soft text-center mx-auto" style="max-width:400px;">No movies found.</p>
    <% } %>
  </div>
</div>
</div>
