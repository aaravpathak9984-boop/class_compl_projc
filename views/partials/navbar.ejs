<!-- Top Right Floating Actions (No full-width bar, No CINEPLEX logo) -->
<div class="top-corner-actions">
  <% if (currentUser) { %>
    <a href="/movies" class="corner-link">Movies</a>
    <a href="/bookings/my" class="corner-link">My Bookings</a>
    <% if (currentUser.role === 'admin') { %>
      <a href="/admin/dashboard" class="corner-link admin-link">Admin</a>
    <% } %>
    <span class="corner-user-badge">
      <span class="corner-avatar"><%= currentUser.name.charAt(0).toUpperCase() %></span>
      <span class="corner-name"><%= currentUser.name %></span>
    </span>
    <form action="/auth/logout" method="POST" class="corner-logout-form">
      <button type="submit" class="corner-logout-btn" title="Log Out">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="mr-1">
          <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
          <polyline points="16 17 21 12 16 7"></polyline>
          <line x1="21" y1="12" x2="9" y2="12"></line>
        </svg>
        Logout
      </button>
    </form>
  <% } else { %>
    <a href="/auth/login" class="corner-login-btn">Log In</a>
    <a href="/auth/register" class="corner-signup-btn">Sign Up</a>
  <% } %>
</div>
